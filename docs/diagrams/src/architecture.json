  "cards": [
    {
      "dot": "emerald",
      "title": "Default: zero keys",
      "items": [
        "Demo agent + in-memory state",
        "Nothing reaches PayPal or an LLM",
        "State resets on restart"
      ]
    },
    {
      "dot": "cyan",
      "title": "Live: local and sandbox only",
      "items": [
        "Credentials honoured only on a loopback bind (scripts/serve.sh), never on Vercel/Render",
        "Toolkit used when both PayPal keys are set and the cached Invoicing probe passes; errors are reported, not replaced by mock rows"
      ]
    },
    {
      "dot": "rose",
      "title": "Human gate",
      "items": [
        "Send, remind and cancel only create a pending action (owner = session cookie, 15 min)",
        "No LLM tool can confirm; /api/confirm runs it once per process",
        "Every route: same-origin JSON, loopback-only while live"
      ]
    }
  ]
