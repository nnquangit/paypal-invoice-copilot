  "cards": [
    {
      "dot": "cyan",
      "title": "Two agents, one gate",
      "items": [
        "The LLM path needs LLM_API_KEY, a loopback bind and no DEMO_MODE / FORCE_DEMO_AGENT",
        "Both paths stop at a pending action owned by the browser session",
        "Cancel on the card posts confirmed:false (cancelled_by_user)"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards",
      "items": [
        "No LLM tool can confirm; only /api/confirm from the same session executes",
        "Other session 403, expired 410, already run 409"
      ]
    },
    {
      "dot": "amber",
      "title": "Live or local",
      "items": [
        "PayPal rows go to the sandbox toolkit after a cached probe; local rows change in memory",
        "Unknown outcome after dispatch is terminal: check the PayPal dashboard"
      ]
    }
