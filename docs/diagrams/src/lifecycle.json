  "cards": [
    {
      "dot": "amber",
      "title": "Wait states",
      "items": [
        "Each write first becomes a pending action owned by the browser session, valid 15 minutes",
        "Confirm executes it once; Cancel on the card leaves the status unchanged",
        "An unknown PayPal outcome is terminal: check the dashboard before proposing again"
      ]
    },
    {
      "dot": "cyan",
      "title": "Who changes status",
      "items": [
        "Local rows: mock-store sendInvoice / remindInvoice / cancelInvoice",
        "PayPal rows: the sandbox toolkit, then the desk row is refreshed",
        "Paid is never set by the app; it comes from PayPal (or the seed data)"
      ]
    },
    {
      "dot": "rose",
      "title": "Guards in code",
      "items": [
        "Send only from DRAFT or SCHEDULED",
        "Remind only from SENT, UNPAID or PARTIALLY_PAID",
        "Cancel from any status except PAID or CANCELLED (drafts too)"
      ]
    }
  ]
