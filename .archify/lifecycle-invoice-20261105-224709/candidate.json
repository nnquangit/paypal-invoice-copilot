{
  "schema_version": 2,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Invoice lifecycle",
    "subtitle": "DRAFT → SENT → PAID / CANCELLED + reminders",
    "output": "docs/diagrams/lifecycle-invoice.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "locale": "en"
  },
  "lanes": [
    { "id": "main", "label": "Invoice status" },
    { "id": "waiting", "label": "Reminders" },
    { "id": "terminal", "label": "Terminal exits" }
  ],
  "states": [
    { "id": "draft", "type": "start", "label": "DRAFT", "sublabel": "create_invoice", "lane": "main", "col": 0, "step": "01", "tag": "local" },
    { "id": "sent", "type": "active", "label": "SENT", "sublabel": "after confirm", "lane": "main", "col": 1, "step": "02", "tag": "client notified" },
    { "id": "unpaid", "type": "waiting", "label": "UNPAID", "sublabel": "awaiting payment", "lane": "main", "col": 2, "step": "03", "tag": "open" },
    { "id": "paid", "type": "success", "label": "PAID", "sublabel": "collected", "lane": "main", "col": 3, "step": "04", "tag": "success" },
    { "id": "remind", "type": "active", "label": "Reminder sent", "sublabel": "reminder_count++", "lane": "waiting", "col": 2, "tag": "confirm first" },
    { "id": "cancelled", "type": "failure", "label": "CANCELLED", "sublabel": "cancel_sent_invoice", "lane": "terminal", "col": 1, "tag": "terminal" },
    { "id": "refunded", "type": "neutral", "label": "REFUNDED", "sublabel": "status only", "lane": "terminal", "col": 3, "tag": "terminal" }
  ],
  "transitions": [
    { "from": "draft", "to": "sent", "label": "confirm send" },
    { "from": "sent", "to": "unpaid", "label": "still open" },
    { "from": "unpaid", "to": "paid", "label": "client pays" },
    { "from": "sent", "to": "paid", "label": "paid promptly" },
    { "from": "unpaid", "to": "remind", "label": "confirm remind", "variant": "dashed" },
    { "from": "remind", "to": "unpaid", "label": "still unpaid", "variant": "dashed" },
    { "from": "sent", "to": "cancelled", "label": "confirm cancel", "variant": "security" },
    { "from": "unpaid", "to": "cancelled", "label": "confirm cancel", "variant": "security" },
    { "from": "paid", "to": "refunded", "variant": "dashed", "label": "status map" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Happy path",
      "items": [
        "create_invoice always starts as DRAFT",
        "ConfirmCard send moves the invoice to SENT",
        "Dashboard aggregates unpaid, paid, and drafts"
      ]
    },
    {
      "dot": "amber",
      "title": "Reminders",
      "items": [
        "send_invoice_reminder needs human confirmation",
        "Mock store increments reminder_count",
        "QR / payment link stays available while unpaid"
      ]
    },
    {
      "dot": "rose",
      "title": "Exits",
      "items": [
        "cancel_sent_invoice is confirmation-gated",
        "PAID / CANCELLED stop reminder prompts",
        "Types also allow PARTIALLY_PAID and PAYMENT_PENDING"
      ]
    }
  ]
}
