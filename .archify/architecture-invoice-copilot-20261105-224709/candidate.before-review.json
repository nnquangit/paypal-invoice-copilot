  "cards": [
    {
      "dot": "cyan",
      "title": "Zero-credential demo",
      "items": [
        "Without LLM or PayPal keys, /api/chat uses runDemoAgent",
        "Invoice tools fall back to the in-memory mock store",
        "Judges can run create \u2192 confirm \u2192 send end-to-end"
      ]
    },
    {
      "dot": "rose",
      "title": "Human-in-the-loop",
      "items": [
        "send_invoice, remind, and cancel only create PendingAction",
        "ConfirmCard calls /api/confirm before any side effect",
        "executePendingAction prefers live toolkit, else mock"
      ]
    },
    {
      "dot": "emerald",
      "title": "PayPal + AI",
      "items": [
        "@paypal/agent-toolkit exposes create/list/send/remind/QR",
        "Vercel AI SDK generateText/streamText drives tool calling",
        "Sandbox is the default PayPal environment"
      ]
    }
  ]
