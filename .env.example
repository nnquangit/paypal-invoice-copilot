# ===== Demo mode (default — works with ZERO credentials) =====
# Leave PayPal + LLM blank, or force with:
# DEMO_MODE=true
# FORCE_DEMO_AGENT=true
DEMO_MODE=false
FORCE_DEMO_AGENT=false

# ===== PayPal sandbox (needed only for LIVE PayPal invoicing) =====
# Verified: @paypal/agent-toolkit@1.11.0 invoicing tools work in sandbox when
# configuration.context.sandbox = true (this app sets that from PAYPAL_ENVIRONMENT).
# Tools used: create_invoice, list_invoices, get_invoice, send_invoice,
# send_invoice_reminder, cancel_sent_invoice, generate_invoice_qr_code, …
#
# Get credentials:
#   1) https://developer.paypal.com/dashboard/applications/sandbox
#   2) Log in with a PayPal Developer account
#   3) Sandbox → Apps & Credentials → Create App (or open Default Application)
#   4) Copy Client ID + Secret
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox-only build: leave empty or "sandbox". Any other value (live, production, …)
# disables PayPal entirely (the app falls back to the local mock desk and says so).
PAYPAL_ENVIRONMENT=sandbox
# Live credentials are honoured only when the server is started with `npm run dev`
# or `npm start` (scripts/serve.sh binds 127.0.0.1 and sets IC_BIND_HOST), only
# for loopback requests, and never on hosted platforms (VERCEL / RENDER env).
# Public demo hosting: PUBLIC_DEMO=true binds 0.0.0.0 and requires DEMO_MODE=true.
# Required: enable Invoicing under Developer Dashboard → Apps → Features (otherwise v2/invoicing returns NOT_AUTHORIZED).

# ===== LLM (OpenAI-compatible) — pick ONE free provider =====
# Required only for the live tool-calling agent. Without LLM_API_KEY the
# built-in demo agent runs the full create/send/remind/cancel/QR flow.

# Option A (recommended free): Groq
#   Get key: https://console.groq.com/keys  → Create API Key → gsk_...
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_API_KEY=gsk_...
#   LLM_MODEL=openai/gpt-oss-20b   (code default when LLM_MODEL is empty)

# Option B: OpenRouter free models
#   Get key: https://openrouter.ai/keys → Create key → sk-or-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_API_KEY=sk-or-...
#   LLM_MODEL=openrouter/free
#   (or any model id ending in :free)

# Option C: Google AI Studio (Gemini OpenAI-compatible endpoint)
#   Get key: https://aistudio.google.com/apikey → Create API key → AIza...
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=AIza...
#   LLM_MODEL=gemini-2.0-flash

# Option D: OpenAI paid
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Defaults in src/lib/config.ts: LLM_BASE_URL=https://api.groq.com/openai/v1, LLM_MODEL=openai/gpt-oss-20b.
# A malformed LLM_BASE_URL disables the live LLM (demo agent is used; /api/health reports why).

# ===== Merchant profile shown on invoices / prompts =====
MERCHANT_BUSINESS_NAME=Quang Studio
MERCHANT_EMAIL=billing@quang.studio
MERCHANT_GIVEN_NAME=Quang
MERCHANT_SURNAME=Ngo
